worker_processes auto;

events {
    worker_connections 1024;
}

http {
    # Use the direct peer address. Configure real IP handling separately if a CDN is added.
    map $request_method $tibon_submit_ip {
        default "";
        POST $binary_remote_addr;
    }
    map $request_method $tibon_submit_site {
        default "";
        POST $server_name;
    }
    map $request_method $tibon_menu_ip {
        default "";
        GET $binary_remote_addr;
    }

    limit_req_zone $tibon_submit_ip zone=tibon_submit_ip:10m rate=8r/m;
    limit_req_zone $tibon_submit_site zone=tibon_submit_site:1m rate=60r/m;
    limit_req_zone $tibon_menu_ip zone=tibon_menu_ip:10m rate=8r/m;

    map "$status:$limit_req_status" $tibon_retry_after {
        default $upstream_http_retry_after;
        "429:REJECTED" 60;
    }
    map "$status:$limit_req_status" $tibon_limit_cache_control {
        default "";
        "429:REJECTED" "no-store";
    }

    upstream tibon_ssr {
        server 127.0.0.1:3000;
    }
    upstream tibon_api {
        server 127.0.0.1:8000;
    }

    server {
        listen 80;
        server_name tibon.example;
        return 308 https://tibon.example$request_uri;
    }

    server {
        listen 443 ssl;
        server_name tibon.example;
        ssl_certificate /path/to/tibon/fullchain.pem;
        ssl_certificate_key /path/to/tibon/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        add_header Strict-Transport-Security "max-age=300" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Permissions-Policy "camera=(), microphone=()" always;
        add_header Retry-After $tibon_retry_after always;
        add_header Cache-Control $tibon_limit_cache_control always;

        proxy_http_version 1.1;
        proxy_set_header Host $server_name;
        proxy_set_header Connection "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Retry-After;
        proxy_intercept_errors off;
        limit_req_status 429;
        error_page 429 = @tibon_rate_limited;

        location ~ ^/api/v1/leads/?$ {
            limit_req zone=tibon_submit_ip burst=7 nodelay;
            limit_req zone=tibon_submit_site burst=19 nodelay;
            proxy_pass http://tibon_api;
        }
        location ~ ^/api/v1/leads/[^/]+/menu/?$ {
            limit_req zone=tibon_menu_ip burst=7 nodelay;
            proxy_pass http://tibon_api;
        }
        location ~ ^/api/v1/health/?$ {
            proxy_pass http://tibon_api;
        }
        location /api/ {
            return 404;
        }
        location ~ ^/(?:docs|redoc|openapi\.json)(?:/|$) {
            return 404;
        }
        location @tibon_rate_limited {
            default_type application/json;
            return 429 '{"detail":"Too many requests"}';
        }
        location / {
            proxy_pass http://tibon_ssr;
        }
    }
}
