POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=tibon
POSTGRES_USER=tibon
# Set a local password before starting Compose or the API.
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
INTERNAL_API_URL=http://127.0.0.1:8000
# For a local Vite proxy. Launch Uvicorn with --no-proxy-headers so the app owns proxy trust.
# Set only the actual proxy peer IPs in deployment.
TRUSTED_PROXY_IPS='["127.0.0.1"]'
# Local defaults. Disable API docs and keep database health off the public gateway.
API_DOCS_ENABLED=true
DATABASE_HEALTH_ENABLED=true
# Used only by the separate Telegram delivery worker.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional absolute path to the backend-only directory with adults.pdf and kids.pdf.
# MENU_PDF_DIR=C:/Projects/tibon-project/backend/private-menus
